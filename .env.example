# Attroupe — configuration. Copier ce fichier en « .env » et remplacer les valeurs factices.
# Ne jamais versionner « .env ».
#
# Les trois secrets se génèrent chacun séparément — jamais le même pour les trois :
#   openssl rand -base64 32
#
# Les valeurs factices ci-dessous sont VOLONTAIREMENT invalides : le serveur refuse de démarrer
# tant qu'elles n'ont pas été remplacées. Une copie brute de ce fichier ne démarre pas.

# --- Déploiement (lues par docker compose) ---

# Étiquette de l'image : « latest » en production, « beta » en pré-production.
ATTROUPE_TAG=latest

# Port publié sur l'hôte (le conteneur écoute toujours sur 3000).
ATTROUPE_PORT=3000

# Adresse d'écoute sur l'hôte. Par défaut 127.0.0.1 : seul le reverse proxy local peut joindre
# l'application. Ne mettre 0.0.0.0 que si le proxy est sur une autre machine — sinon un client
# direct pourrait forger ses en-têtes d'adresse et contourner la limitation de cadence.
# ATTROUPE_BIND=127.0.0.1

# --- Application : obligatoires ---

# URL publique de l'instance. Sert aux liens des e-mails et aux URL de flux iCal.
# En production : https://attroupe.fr
ATTROUPE_BASE_URL=https://attroupe.fr

# Signature des cookies de session. 32 octets en base64 minimum.
ATTROUPE_SESSION_SECRET=A_GENERER__openssl_rand_base64_32

# Chiffrement des clés d'API Immich. 32 octets en base64 minimum.
# Sa perte rend les configurations Immich illisibles (elles se ressaisissent).
ATTROUPE_ENCRYPTION_KEY=A_GENERER__openssl_rand_base64_32

# Signature des URL de médias (photos). 32 octets en base64 minimum.
ATTROUPE_SIGNED_URL_SECRET=A_GENERER__openssl_rand_base64_32

# --- Application : facultatives ---

# Dossier de la base SQLite et des fichiers déposés (le volume « ./data » du compose).
ATTROUPE_DATA_DIR=/data

# Clé d'API Brevo. Sans elle, les e-mails restent en file et l'interface le signale.
BREVO_API_KEY=xkeysib-cle-factice

# Expéditeur des e-mails (obligatoire dès que BREVO_API_KEY est renseignée).
BREVO_SENDER_EMAIL=no-reply@attroupe.fr

# Nom affiché de l'expéditeur.
BREVO_SENDER_NAME=Attroupe

# Inscriptions : « open » (ouvertes) ou « invite » (sur invitation seulement).
ATTROUPE_REGISTRATION=open

# Autorise des URL Immich sur adresses privées (cas normal en homelab).
ATTROUPE_IMMICH_ALLOW_PRIVATE=false

# Nombre de proxys de confiance en amont (Nginx Proxy Manager = 1), pour l'adresse réelle du client.
ATTROUPE_TRUST_PROXY=1

# Niveau de journalisation : debug, info, warn ou error.
ATTROUPE_LOG_LEVEL=info

# Fuseau du conteneur, pour les journaux et les tâches quotidiennes.
TZ=Europe/Paris

# Port d'écoute INTERNE du serveur hors Docker (développement). Dans le conteneur, laisser 3000 :
# c'est le port que le compose publie. Pour changer le port côté hôte, utiliser ATTROUPE_PORT.
# PORT=3000
